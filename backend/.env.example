# SettleX Backend — Environment Variables
# Copy this file to .env and fill in the values.

# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/settlex

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ─── AI / LLM Service ────────────────────────────────────────
# Provider: openai | gemini | azure  (used by src/services/ai.service.js)
AI_PROVIDER=gemini
AI_API_KEY=YOUR_AI_API_KEY_HERE
AI_MODEL=gemini-2.0-flash

# ─── File Uploads ─────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Frontend Origin (CORS) ──────────────────────────────────
CORS_ORIGIN=http://localhost:3000
